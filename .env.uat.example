# Real UAT 必须由部署系统注入真实密钥；不要直接使用示例值。
APP_ENV=uat
CONTRACT_TRUSTED_UPSTREAM_TOKEN=
DASHSCOPE_API_KEY=
ADMIN_API_TOKEN=
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
API_PORT=28000
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_PUBLISHED_PORT=33307
MYSQL_DATABASE=contract_intelligence_uat
MYSQL_PASSWORD=
CACHE_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PUBLISHED_PORT=26379
MILVUS_URI=http://milvus:19530
MILVUS_PUBLISHED_PORT=39530
MILVUS_HEALTH_PUBLISHED_PORT=29091
MINIO_API_PUBLISHED_PORT=29000
MINIO_CONSOLE_PUBLISHED_PORT=29001
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
CORS_ALLOW_ORIGINS=["http://127.0.0.1:28000","http://localhost:28000"]

# ---- 浏览器演示会话（只在 dev/test/uat 生效；生产环境必须保持 false）----
# 开启后页面响应会下发服务端签名票据，浏览器以固定演示身份访问合同接口，
# 可信上游令牌始终留在服务端。生产环境误开时服务会拒绝启动。
CONTRACT_BROWSER_DEMO_SESSION=false
CONTRACT_DEMO_TENANT_ID=demo-tenant
CONTRACT_DEMO_USER_ID=demo-user
CONTRACT_DEMO_VISIBILITY=private
CONTRACT_DEMO_USER_ROLES=["legal","public"]
CONTRACT_DEMO_SESSION_TTL_SECONDS=28800
