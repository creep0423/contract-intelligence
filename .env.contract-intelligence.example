# Contract Intelligence clean deployment. Copy to .env.contract-intelligence and set secrets locally.
APP_ENV=dev
LOG_LEVEL=INFO
ACTIVE_SCENARIO_ID=tender_contract_risk
SCENARIO_CONFIG_DIR=/app/scenarios
API_PORT=18000
APP_BASE_IMAGE=contract-intelligence-base:py312

PRODUCT_DISPLAY_NAME=知契
PRODUCT_ENGLISH_DESCRIPTOR=Enterprise Intelligence
CONTRACT_PRODUCT_DESCRIPTOR=Contract Intelligence
PRODUCT_DESCRIPTION=企业合同履约与风险智能
PRODUCT_TAGLINE=从原文证据，到业务判断。
CONTRACT_TAGLINE=看清条款，掌握履约，提前发现风险。
PRODUCT_META_DESCRIPTION=面向企业合同履约、义务、风险与原文证据分析的智能工作平台。

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_PUBLISHED_PORT=23307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=contract_intelligence

CACHE_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PUBLISHED_PORT=16379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_KEY_PREFIX=ci:v1

MILVUS_URI=http://milvus:19530
MILVUS_DATABASE=
MILVUS_PUBLISHED_PORT=29530
MILVUS_HEALTH_PUBLISHED_PORT=19091
MINIO_API_PUBLISHED_PORT=19000
MINIO_CONSOLE_PUBLISHED_PORT=19001
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

DASHSCOPE_API_KEY=
ADMIN_API_TOKEN=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60

EMBEDDING_MODEL_PATH=/app/models/bge-m3
RERANKER_MODEL_PATH=/app/models/bge-reranker-large
INTENT_MODEL_PATH=/app/models/bert_intent_classifier_v1
INTENT_MODEL_VERSION=bert-intent-v1

CONTRACT_TRUSTED_UPSTREAM_TOKEN=
CORS_ALLOW_ORIGINS=["http://localhost:18000","http://127.0.0.1:18000"]
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=contract-intelligence
